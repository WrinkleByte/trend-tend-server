# Settings for docker-compose.prod.yml. Copy to `.env` in this directory
# (git-ignored) and fill in every REQUIRED value; Compose refuses to start
# until they are set.
#
# Generate each secret separately, e.g.:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
#   openssl rand -base64 48
# Store them somewhere safe. Losing JWT_SECRET only logs everyone out;
# losing the database passwords means editing roles inside Postgres.

# --- REQUIRED ---------------------------------------------------------------

# Postgres bootstrap role password. Only applied when the database volume is
# first created; changing it afterwards does not change the real password.
POSTGRES_PASSWORD=

# Password for `wrinklebyte_app`, the non-superuser role the backend queries
# as (so row-level security applies). Set once, before first start.
APP_DB_PASSWORD=

# Signs login tokens. 32+ bytes; the backend refuses to start otherwise.
# Changing it signs every user out.
JWT_SECRET=

# The URL people (and the mobile apps) use to reach this instance, with no
# trailing slash, e.g. https://maintenance.example.com. Used in emailed
# password-reset and invite links, and as the default pairing URL.
FRONTEND_URL=

# --- OPTIONAL ---------------------------------------------------------------

# Which release to run. Pin this to a specific version rather than "latest"
# so an upgrade only happens when you choose it.
# WRINKLEBYTE_VERSION=1.0.1

# Where the images come from: Docker Hub by default. The same images are on
# the GitHub Container Registry (ghcr.io/wrinklebyte), or point this at your
# own registry or fork.
# WRINKLEBYTE_IMAGE_PREFIX=wrinklebyte

# Host port the web app (and /api) is published on.
# WEB_HOST_PORT=8080

# Only if the mobile apps must use a different URL than FRONTEND_URL.
# Seeds on first boot; change later under Settings > Instance in the web app.
# PUBLIC_API_URL=

# Outgoing email for password resets and household invites. Seeds on first
# boot only; change later in the web app's instance settings.
# SMTP_ENABLED=true
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_USE_TLS=true
# SMTP_FROM_ADDRESS=
# SMTP_FORCE_ENV=false
