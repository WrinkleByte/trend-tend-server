# Local machine overrides for docker-compose.yml — copy this file to
# `.env` (git-ignored) and fill in values. Compose reads `.env` from this
# directory automatically; nothing here takes effect until copied.

# --- REQUIRED for any non-local deployment ---
#
# Signing key for auth tokens. The backend REFUSES TO START without this
# set to a real value (see app/config.py) — the built-in default is
# published in this repo's source, so any instance still using it has an
# auth system anyone can forge tokens against. Must be 32+ bytes.
#
# Generate one:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
#
# Changing it later invalidates every existing session and login.
# JWT_SECRET=

# Local development ONLY. Bypasses the startup guard above so the
# docker-compose dev stack can run with its throwaway default secret.
# Never set this on a real deployment.
# DEV_MODE=true

# Override if the default host port is already taken on your machine —
# container still listens on the port shown internally regardless.
# BACKEND_HOST_PORT=8000
# POSTGRES_HOST_PORT=5432
# WEB_HOST_PORT=5173

# Public URL the web app is reachable at — baked into the password-reset
# link sent by email, so it has to be whatever a user's browser can
# actually reach, not an internal Docker hostname. Defaults to the local
# dev URL, which is wrong for any real deployment.
# FRONTEND_URL=https://your-domain.example

# SMTP relay — only seeds the instance_settings row on first boot (see
# backend/app/core/instance_settings.py); reconfigure later via the
# instance-settings admin UI instead of editing this. Gmail example below
# (needs a Google Account App Password, not your normal login password:
# https://myaccount.google.com/apppasswords — Gmail also caps at 500
# recipients/day, fine for password-reset/notification email, not bulk).
# SMTP_ENABLED=true
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USERNAME=you@gmail.com
# SMTP_PASSWORD=
# SMTP_USE_TLS=true
# SMTP_FROM_ADDRESS=you@gmail.com
#
# Uncomment to keep the above as the permanent SMTP config, overwriting any
# changes made via the admin instance-settings webui on every request.
# SMTP_FORCE_ENV=true
