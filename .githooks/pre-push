# The slow checks (full test suites + build) that pre-commit deliberately
# skips — pushes are much less frequent than commits, so the extra time is
# worth it here. Runs unconditionally (not scoped to changed files) since
# it's cheap relative to how often it fires. Installed via
# scripts/setup-git-hooks.sh — see that file and README.md's "Local CI"
# section for why this lives here instead of GitHub Actions.
#
# Missing tooling is a FAILURE, not a warning — see the same note in
# pre-commit for why. Falls back to the docker-compose stack before giving
# up; escape hatch is SKIP_HOOK_TOOLING=1 or --no-verify.
set -uo pipefail

REPO_ROOT="$(git rev-parse --show-toplevel)"
cd "$REPO_ROOT"

status=0

compose_service_running() {
    docker compose ps --status running --services 2>/dev/null | grep -qx "$1"
}

unavailable() {
    local what="$1" remedy="$2"
    if [[ "${SKIP_HOOK_TOOLING:-0}" == "1" ]]; then
        echo "[pre-push] SKIPPING $what — SKIP_HOOK_TOOLING=1 was set." >&2
        return 0
    fi
    echo "[pre-push] ERROR: cannot run $what — no local tooling and no running container." >&2
    echo "[pre-push]        $remedy" >&2
    echo "[pre-push]        Or re-run with SKIP_HOOK_TOOLING=1 if you accept the risk." >&2
    return 1
}

echo "[pre-push] Running backend test suite..."
if compose_service_running backend; then
    docker compose exec -T backend pytest -q || status=1
elif [[ -x backend/.venv/bin/pytest ]]; then
    (cd backend && .venv/bin/pytest -q) || status=1
elif command -v pytest >/dev/null 2>&1; then
    (cd backend && pytest -q) || status=1
else
    unavailable "backend tests" \
        "Set up backend/.venv (see backend/README.md), or start the stack: docker compose up -d backend" \
        || status=1
fi

echo "[pre-push] Running web lint + build..."
if compose_service_running web; then
    docker compose exec -T web npm run lint || status=1
    docker compose exec -T web npm run build || status=1
elif [[ -d web/node_modules ]]; then
    (cd web && npm run lint) || status=1
    (cd web && npm run build) || status=1
else
    unavailable "web build" \
        "Run 'npm install' in web/, or start the stack: docker compose up -d web" \
        || status=1
fi

if [[ $status -ne 0 ]]; then
    echo "[pre-push] Checks failed — fix the issues above, or bypass with 'git push --no-verify' (not recommended)." >&2
    exit 1
fi

exit 0
