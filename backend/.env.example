DATABASE_URL=postgresql+asyncpg://wrinklebyte:wrinklebyte@localhost:5432/wrinklebyte
JWT_SECRET=dev-secret-change-me-please-use-a-random-32-byte-value-in-production
JWT_ACCESS_TOKEN_TTL_MINUTES=15
JWT_REFRESH_TOKEN_TTL_DAYS=30
STORAGE_BACKEND=local_disk
STORAGE_LOCAL_ROOT=./data/attachments
STORAGE_S3_BUCKET=
STORAGE_S3_ENDPOINT_URL=
STORAGE_S3_ACCESS_KEY=
STORAGE_S3_SECRET_KEY=

# Base URL the web app is reachable at — used to build the link in
# password-reset email. Wrong for any real deployment if left as localhost.
FRONTEND_URL=http://localhost:5173

# SMTP relay — only seeds the instance_settings row on first boot (see
# app/core/instance_settings.py); reconfigure later via the admin
# instance-settings UI, or set SMTP_FORCE_ENV=true below to keep this file
# as the permanent source of truth instead.
# SMTP_ENABLED=true
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USERNAME=you@gmail.com
# SMTP_PASSWORD=
# SMTP_USE_TLS=true
# SMTP_FROM_ADDRESS=you@gmail.com
# SMTP_FORCE_ENV=false
