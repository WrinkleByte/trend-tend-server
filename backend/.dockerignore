# Keep the build context to what the images actually COPY. Without this,
# local venvs, attachment data and caches are sent to the Docker daemon on
# every build, and a stray file could end up baked into an image.
.venv/
venv/
data/
tests/
**/__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/
*.egg-info/
.env
.env.*
# macOS metadata files from the Mac side of the SMB share. A `._*` file in
# alembic/versions/ is imported as a migration and crashes startup with
# "source code string cannot contain null bytes" (see backend/CLAUDE.md).
**/._*
**/.DS_Store
