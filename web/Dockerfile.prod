# Production image for the web PWA (2026-08-19 review, D2).
#
# The sibling Dockerfile runs `npm run dev` and is the local-development
# stack; this is the one to deploy. Until now the only containerised path
# was that dev server, which for a product whose self-hosting story is a
# headline privacy feature meant self-hosters were pointed at a Vite dev
# server: no asset hashing, no compression, far more attack surface, and
# unusable performance.
#
# Build from the web/ directory:
#   docker build -f Dockerfile.prod -t wrinklebyte-web:prod .
#
# The API base is baked in at BUILD time, not runtime -- Vite inlines
# import.meta.env at build. The default assumes the reverse proxy in
# nginx.conf below, which serves the app and proxies /api to the backend on
# the same origin. Same-origin matters: it's what lets the app avoid CORS
# entirely, and the backend has no CORSMiddleware (see app/main.py).

FROM node:20-slim AS build
WORKDIR /app

# Copy manifests first so the dependency layer caches independently of
# source changes. `npm ci` (not `install`) so the lockfile is authoritative
# -- a build that silently resolves different versions than were tested is
# not a reproducible build.
COPY package.json package-lock.json ./
RUN npm ci

COPY . .
RUN npm run build


FROM nginx:1.27-alpine AS runtime

# Non-root. nginx's own worker processes already drop privileges, but the
# master running as root is a needless capability for a static file server.
# The alpine image ships an `nginx` user (uid 101) already.
#
# The pidfile needs creating and chowning EXPLICITLY: /var/run is a symlink
# to /run, so a `chown -R` on it doesn't touch the real directory, and the
# master then dies at startup with
#   [emerg] open() "/run/nginx.pid" failed (13: Permission denied)
# -- which the image build cannot catch, only actually running it can.
RUN mkdir -p /var/cache/nginx \
    && touch /run/nginx.pid \
    && chown -R nginx:nginx /var/cache/nginx /run/nginx.pid

COPY nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist /usr/share/nginx/html

# 8080 rather than 80 so the container needs no privileged port and can run
# as a non-root user.
EXPOSE 8080
USER nginx

CMD ["nginx", "-g", "daemon off;"]
